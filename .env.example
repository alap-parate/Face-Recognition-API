APP_NAME=Gops Face Recognition API
APP_ENV=development
DEBUG=true
# Log per-step pipeline timings (decode, model, DB, etc.) at INFO for the app logger
PIPELINE_TIMING=false
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/face_recognition
CREATE_VECTOR_EXTENSION=true

FACE_BACKEND=insightface
INSIGHTFACE_MODEL_NAME=buffalo_s
INSIGHTFACE_MODEL_ROOT=./models/insightface
OPENCV_MODEL_ROOT=./models/opencv
OPENCV_DETECTOR_MODEL_NAME=face_detection_yunet_2023mar.onnx
OPENCV_RECOGNIZER_MODEL_NAME=face_recognition_sface_2021dec.onnx
OPENCV_DETECTION_THRESHOLD=0.85
OPENCV_NMS_THRESHOLD=0.3
OPENCV_TOP_K=5000
ONNX_PROVIDER=CPUExecutionProvider
CPU_THREADS=1

FACE_EMBEDDING_DIM=512
DETECTION_THRESHOLD=0.55
DETECTION_WIDTH=512
DETECTION_HEIGHT=512
MAX_INPUT_IMAGE_SIDE=1280
MIN_FACE_SIZE_PX=90
MIN_BLUR_SCORE=60
CLAHE_CLIP_LIMIT=2.0
CLAHE_TILE_GRID_SIZE=8

MIN_ENROLLMENT_IMAGES=3
MAX_ENROLLMENT_IMAGES=5
ENROLLMENT_OUTLIER_SIMILARITY=0.35

INSIGHTFACE_RECOGNITION_MATCH_THRESHOLD=0.35
OPENCV_RECOGNITION_MATCH_THRESHOLD=0.637
RECOGNITION_TOP_K_DEFAULT=3
RECOGNITION_TOP_K_MAX=10

HNSW_M=16
HNSW_EF_CONSTRUCTION=64
